# =====================================================
# EDYRA Enterprise LMS — Environment Template
# Copy to .env and fill in all values before running.
# NEVER commit .env to version control.
# =====================================================

# ─────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─────────────────────────────────────────────────────
# MONGODB
# ─────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edyra?retryWrites=true&w=majority
MONGO_USER=admin
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_DB=0

# ─────────────────────────────────────────────────────
# JWT / AUTH
# ─────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_HEX_STRING
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost

# ─────────────────────────────────────────────────────
# SMTP / EMAIL
# ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="EDYRA LMS" <noreply@yourdomain.com>

# ─────────────────────────────────────────────────────
# FRONTEND / CORS
# ─────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# ─────────────────────────────────────────────────────
# FILE STORAGE / UPLOADS
# ─────────────────────────────────────────────────────
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520
AWS_S3_BUCKET=edyra-uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_URL=

# ─────────────────────────────────────────────────────
# GOOGLE OAUTH
# ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-backend.com/api/auth/oauth/google/callback

# ─────────────────────────────────────────────────────
# AI / LLM
# ─────────────────────────────────────────────────────
AI_ENABLED=true
OLLAMA_URL=http://localhost:11434
AI_MODEL=llama3
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ─────────────────────────────────────────────────────
# NEXT.JS FRONTEND
# ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-backend.com/api
NEXT_PUBLIC_WS_URL=wss://your-backend.com

# ─────────────────────────────────────────────────────
# DOCKER / NGINX
# ─────────────────────────────────────────────────────
BACKEND_PORT=5000
FRONTEND_PORT=3000
MONGO_PORT=27017
REDIS_PORT=6379
