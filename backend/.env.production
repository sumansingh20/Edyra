# =====================================================
# EDYRA Backend — Production Environment
# Set these in Vercel/Railway Environment Variables
# NEVER commit .env to version control
# =====================================================

# ── Server ────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── MongoDB Atlas ──────────────────────────────────────
# Replace with your actual Atlas connection string
MONGODB_URI=mongodb+srv://suman:suman@cluster0.1enfs6w.mongodb.net/edyra?retryWrites=true&w=majority

# ── JWT / Auth ────────────────────────────────────────
# Generate strong secrets: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_64_CHAR_HEX_STRING_FOR_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_HEX_STRING_FOR_PRODUCTION
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS / Frontend ───────────────────────────────────
# Your Vercel deployment URLs
FRONTEND_URL=https://edyra.vercel.app
CORS_ORIGIN=https://edyra.vercel.app
ALLOWED_ORIGINS=https://edyra.vercel.app,https://edyra-frontend.vercel.app

# ── Cookie Domain ─────────────────────────────────────
# Set to your production domain (no protocol)
COOKIE_DOMAIN=.vercel.app

# ── Redis Cloud (Optional) ────────────────────────────
# REDIS_URL=redis://default:<password>@<host>:<port>

# ── File Storage ──────────────────────────────────────
STORAGE_PROVIDER=local
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=20971520

# ── Email (SMTP) ──────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="EDYRA LMS" <noreply@yourdomain.com>

# ── Email via Resend (alternative) ────────────────────
# RESEND_API_KEY=re_...

# ── Monitoring (Sentry) ───────────────────────────────
# SENTRY_DSN=https://...
# SENTRY_ENVIRONMENT=production

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Security ──────────────────────────────────────────
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=120