# =====================================================
# EDYRA Frontend — Production Environment (Vercel)
# Set these in Vercel Environment Variables
# =====================================================

# Backend API URL (your deployed backend)
NEXT_PUBLIC_API_URL=https://edyrabackend.vercel.app/api

# Socket URL for real-time features
NEXT_PUBLIC_SOCKET_URL=https://edyrabackend.vercel.app

# Application
NEXT_PUBLIC_APP_NAME=EDYRA
NEXT_PUBLIC_APP_URL=https://edyra.vercel.app

# Backend URL for rewrites
BACKEND_URL=https://edyrabackend.vercel.app/api